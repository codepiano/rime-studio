{
  "legacy": {
    "start": [
      "./scripts/start.sh"
    ],
    "stop": [
      "./scripts/stop.sh"
    ],
    "status": [
      "./scripts/status.sh"
    ]
  },
  "prepare": [
    [
      "node",
      "scripts/check-toolchain.mjs"
    ],
    [
      "corepack",
